[Desktop Entry]
Name=Linux Whisper
Comment=Local speech-to-text transcription and dictation
Exec=linux-whisper
Icon=com.linuxwhisper.LinuxWhisper
Terminal=false
Type=Application
Categories=AudioVideo;Audio;
Keywords=whisper;transcription;dictation;speech;voice;
StartupNotify=true
X-GNOME-UsesNotifications=true
